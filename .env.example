# OmniPulse AI - Database & Environment Configuration

# Database Engine Mode: 'mysql' or 'sqlite'
DB_ENGINE=sqlite

# MySQL Configuration (Used when DB_ENGINE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=omnipulse_bi

# SQLite Configuration (Used when DB_ENGINE=sqlite for portable/offline mode)
SQLITE_DB_PATH=database/omnipulse.db

# Active Domain Template:
# Options: 'supermarket', 'pharmacy', 'restaurant', 'fashion', 'electronics', 'ecommerce'
ACTIVE_DOMAIN=supermarket

# Application Settings
APP_NAME=OmniPulse AI
APP_ENV=development
DEBUG=True
